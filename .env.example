# Copie para .env (fora do git) se quiser mudar algum padrão.
# É um banco local, só seu — a senha não protege nada de produção.
OBSERVADH_DB_USER=observadh
OBSERVADH_DB_PASSWORD=observadh
# Porta do banco no seu computador (5433 para não brigar com um Postgres
# local que já use a 5432). Conecte o DBeaver/psql em localhost:5433.
OBSERVADH_DB_PORTA_LOCAL=5433
